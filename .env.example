# Spotify: descomenta y pon tu Client ID si usas Spotify
# VITE_SPOTIFY_CLIENT_ID=your_client_id_here

# Apple Music: descomenta si tienes cuenta Apple Developer
# APPLE_TEAM_ID=your_team_id
# APPLE_KEY_ID=your_key_id

# YouTube login: descomenta SOLO si quieres ver tus playlists (no necesario para pegar URLs públicas)
# VITE_YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# VITE_YOUTUBE_CLIENT_SECRET=your-client-secret
